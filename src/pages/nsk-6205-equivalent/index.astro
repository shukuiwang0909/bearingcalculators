---
import Base from '../../layouts/Base.astro';
import { CHINESE_MODEL_BY_MODEL } from '../../data/chinese-equivalents';

const price = CHINESE_MODEL_BY_MODEL['6205'];
const title = 'NSK 6205 Equivalent — Chinese Alternatives & Interchange | BearingCalculators';
const description = 'NSK 6205 equivalent bearings: C&U, ZWZ, LYC, HRB Chinese alternatives. Same dimensions 25×52×15mm as SKF 6205, FAG 6205. ISO 15:2017 interchangeable.';
---
<Base title={title} description={description} breadcrumbItems={[
  { name: 'Interchange', url: '/bearing-interchange/' },
  { name: 'NSK 6205 Equivalent', url: '/nsk-6205-equivalent/' },
]}>
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-8">
      <p class="text-xs text-theme-muted mb-2">NSK → Chinese Alternative</p>
      <h1 class="text-3xl font-bold text-theme-primary mb-2">NSK 6205 Equivalent Bearings</h1>
      <p class="text-theme-secondary">The <strong>NSK 6205</strong> is a 25×52×15mm deep groove ball bearing. NSK suffix convention: <span class="font-mono">6205 2RS</span> (sealed), <span class="font-mono">6205 ZZ</span> (shielded). Fully interchangeable with SKF 6205, FAG 6205, and Chinese alternatives.</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="card">
          <h2 class="text-lg font-semibold text-theme-primary mb-4">NSK 6205 Specifications</h2>
          <div class="grid grid-cols-3 gap-3 mb-4">
            {[['Bore','25 mm'],['OD','52 mm'],['Width','15 mm'],['C','14.0 kN'],['C₀','7.85 kN'],['n (grease)','13,000 rpm']].map(([l,v]) => (
              <div class="bg-theme-tertiary rounded-lg p-3">
                <p class="text-xs text-theme-muted">{l}</p>
                <p class="font-semibold text-theme-primary font-mono text-sm">{v}</p>
              </div>
            ))}
          </div>
          <p class="text-sm text-theme-secondary">NSK seal suffix differs from SKF: use <span class="font-mono">6205 2RS</span> (not 2RS1) and <span class="font-mono">6205 ZZ</span> (not Z) when ordering from NSK.</p>
        </div>

        <div class="card">
          <h2 class="text-lg font-semibold text-theme-primary mb-3">Chinese Equivalent Bearings</h2>
          {price && <p class="text-sm text-theme-secondary mb-4">Indicative FOB: <strong class="text-theme-primary">${price.priceRangeUSD.min}–${price.priceRangeUSD.max} USD/pc</strong> vs. NSK approximately $2.50–4.00 USD/pc.</p>}
          <table class="w-full text-sm mb-4">
            <thead><tr class="border-b border-theme">
              <th class="text-left py-2 pr-4 text-theme-muted font-medium">Chinese Brand</th>
              <th class="text-left py-2 pr-4 text-theme-muted font-medium">Model</th>
              <th class="text-left py-2 text-theme-muted font-medium">Tier</th>
            </tr></thead>
            <tbody>
              {[['C&U','6205','Budget'],['ZWZ','6205','Mid-range'],['LYC','6205','Mid-range'],['HRB','6205','Budget']].map(([f,m,t]) => (
                <tr class="border-b border-theme">
                  <td class="py-2 pr-4 font-semibold text-theme-primary">{f}</td>
                  <td class="py-2 pr-4 font-mono text-theme-secondary">{m}</td>
                  <td class="py-2 text-xs text-theme-secondary">{t}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <a href="/request-a-quote/" class="inline-block accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-colors" style="color:#07090c;">Request Quote</a>
        </div>

        <div class="card">
          <h2 class="text-lg font-semibold text-theme-primary mb-3">NSK vs SKF vs Chinese — Suffix Differences</h2>
          <table class="w-full text-sm">
            <thead><tr class="border-b border-theme">
              <th class="text-left py-2 pr-6 text-theme-muted font-medium">Brand</th>
              <th class="text-left py-2 pr-6 text-theme-muted font-medium">2RS sealed</th>
              <th class="text-left py-2 text-theme-muted font-medium">ZZ shielded</th>
            </tr></thead>
            <tbody>
              {[['NSK','6205 2RS','6205 ZZ'],['SKF','6205 2RS1','6205 Z'],['FAG','6205 2RS','6205 Z'],['Chinese','6205 2RS','6205 ZZ']].map(([b,rs,zz]) => (
                <tr class="border-b border-theme">
                  <td class="py-2 pr-6 font-semibold text-theme-primary">{b}</td>
                  <td class="py-2 pr-6 font-mono text-theme-secondary">{rs}</td>
                  <td class="py-2 font-mono text-theme-secondary">{zz}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="space-y-4">
        <div class="card">
          <h3 class="font-semibold text-theme-primary mb-3">6205 Resources</h3>
          <ul class="text-sm space-y-2">
            <li><a href="/6205-bearing/" class="accent-text hover:underline">6205 Full Datasheet →</a></li>
            <li><a href="/skf-6205-equivalent/" class="text-theme-secondary hover:accent-text">SKF 6205 Equivalent →</a></li>
            <li><a href="/timken-6205-equivalent/" class="text-theme-secondary hover:accent-text">Timken 6205 Equivalent →</a></li>
            <li><a href="/bearing-life-calculator/" class="text-theme-secondary hover:accent-text">6205 Life Calculator →</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
