---
import Base from '../../../layouts/Base.astro';

const title = 'How to Read a Bearing Part Number: SKF, NSK, FAG, NTN Decoded | BearingCalculators';
const description = 'Step-by-step guide to decoding bearing part numbers from SKF, NSK, FAG, and NTN. Covers type codes, bore diameter, series, seals, clearance, and accuracy suffix — with worked examples.';
const pubDate = '2026-10-11';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does 6205-2RS1 mean?",
      "acceptedAnswer": { "@type": "Answer", "text": "6205-2RS1 is an SKF part number. '6' = deep groove ball bearing type. '2' = light series (62xx outer diameter series). '05' = bore code: 05 × 5 = 25 mm bore diameter. '2RS1' = two rubber contact seals (SKF suffix). Full dimensions: 25×52×15 mm (bore × OD × width), dynamic load rating C = 14.0 kN." }
    },
    {
      "@type": "Question",
      "name": "What do the NSK suffixes DDU, VV, and ZZ mean?",
      "acceptedAnswer": { "@type": "Answer", "text": "NSK DDU = two rubber contact seals (equivalent to SKF 2RS1). NSK VV = two non-contact rubber seals, lower torque, less effective against contamination. NSK ZZ = two steel shields, non-contact, lowest torque. Seals are preferable for dirty/wet environments; shields for clean environments requiring lower friction." }
    },
    {
      "@type": "Question",
      "name": "What does C3 mean in a bearing number?",
      "acceptedAnswer": { "@type": "Answer", "text": "C3 indicates internal clearance Group 3 — greater than standard (CN/C0) clearance. C3 is used when the bearing will experience significant temperature rise in service, causing the inner ring to expand more than the outer. Common applications: electric motors, pumps, gearboxes. Using standard clearance in these applications results in premature failure from reduced internal clearance." }
    },
    {
      "@type": "Question",
      "name": "How do bore codes work for bearings smaller than 20 mm?",
      "acceptedAnswer": { "@type": "Answer", "text": "For bore codes 00–03, the multiplier is not 5. Instead: 00 = 10 mm, 01 = 12 mm, 02 = 15 mm, 03 = 17 mm. For bore code 04 and above, multiply by 5: 04 = 20 mm, 05 = 25 mm, etc. Bearings below 10 mm bore use the actual bore diameter directly in the part number (e.g., 6000 = 10 mm bore, 619/8 = 8 mm bore)." }
    },
    {
      "@type": "Question",
      "name": "Are bearing numbers the same across brands?",
      "acceptedAnswer": { "@type": "Answer", "text": "The base number (e.g., 6205) follows ISO 15 and is consistent across all major brands — same bore, OD, and width. However, suffixes differ by brand: SKF 2RS1 = NSK DDU = FAG 2RSR = NTN 2RS. The base number is interchangeable; always convert suffixes when sourcing cross-brand." }
    },
  ],
};
---
<Base
  title={title}
  description={description}
  ogType="article"
  pubDate={pubDate}
  jsonLd={faqSchema}
  breadcrumbItems={[
    { name: 'Blog', url: '/blog/' },
    { name: 'How to Read a Bearing Part Number', url: '/blog/how-to-read-bearing-part-number/' },
  ]}
>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <header class="mb-8">
      <p class="text-xs text-theme-muted mb-2">Published 11 Oct 2026 · 8 min read</p>
      <h1 class="text-3xl font-bold text-theme-primary mb-3">How to Read a Bearing Part Number</h1>
      <p class="text-theme-secondary text-lg">A 6205-2RS1/C3 tells you the type, size, seals, and clearance class — but only if you know the code. This guide decodes SKF, NSK, FAG, and NTN part numbers from left to right.</p>
    </header>

    <div class="space-y-6 text-theme-secondary">

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">The Structure of a Bearing Part Number</h2>
        <p>Most rolling bearing part numbers follow ISO 15 and share a common structure:</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm border border-theme rounded-lg">
            <thead>
              <tr class="bg-theme-tertiary">
                <th class="px-4 py-2 text-left text-theme-primary font-semibold">Position</th>
                <th class="px-4 py-2 text-left text-theme-primary font-semibold">What it encodes</th>
                <th class="px-4 py-2 text-left text-theme-primary font-semibold">Example: 6205-2RS1/C3</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['Prefix', 'Manufacturer internal code (often omitted)', '—'],
                ['Type digit(s)', 'Bearing type (6 = DGBB, 7 = angular contact, N = cylindrical, 3 = taper)', '6'],
                ['Series digit', 'Diameter/width series (0–4, or 2–4 for light/medium/heavy)', '2'],
                ['Bore code', '00–03: special; 04+ = code × 5 mm', '05 = 25 mm'],
                ['Suffix', 'Seals, shields, clearance, accuracy, cage', '2RS1/C3'],
              ].map(([pos, desc, ex]) => (
                <tr class="border-t border-theme">
                  <td class="px-4 py-2 font-mono accent-text">{pos}</td>
                  <td class="px-4 py-2">{desc}</td>
                  <td class="px-4 py-2 font-mono text-theme-primary">{ex}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Bearing Type Codes</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { code: '6xxx', type: 'Deep Groove Ball Bearing (DGBB)', note: 'Most common. Handles radial + moderate axial load.' },
            { code: '7xxx', type: 'Angular Contact Ball Bearing', note: 'High-speed combined loads. Usually paired.' },
            { code: 'N/NU/NJ', type: 'Cylindrical Roller Bearing', note: 'High radial load capacity, low friction.' },
            { code: '3xxx / 320xx', type: 'Tapered Roller Bearing', note: 'Heavy radial + axial loads. Wheel hubs, gearboxes.' },
            { code: '22xxx / 23xxx', type: 'Spherical Roller Bearing', note: 'Misalignment-tolerant, heavy radial load.' },
            { code: '51xxx / 53xxx', type: 'Thrust Ball Bearing', note: 'Axial load only. Low speed.' },
          ].map(b => (
            <div class="p-3 card">
              <p class="font-mono accent-text text-sm font-bold">{b.code}</p>
              <p class="text-sm text-theme-primary font-medium mt-0.5">{b.type}</p>
              <p class="text-xs text-theme-muted mt-1">{b.note}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Bore Diameter Code Table</h2>
        <p>For the most common sizes (bore codes 04 and above): multiply the two-digit code by 5 to get bore in mm.</p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full text-sm border border-theme rounded-lg">
            <thead>
              <tr class="bg-theme-tertiary">
                <th class="px-3 py-2 text-left text-theme-primary">Code</th>
                <th class="px-3 py-2 text-left text-theme-primary">Bore (mm)</th>
                <th class="px-3 py-2 text-left text-theme-primary">Code</th>
                <th class="px-3 py-2 text-left text-theme-primary">Bore (mm)</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['00','10','10','50'],['01','12','11','55'],['02','15','12','60'],
                ['03','17','13','65'],['04','20','14','70'],['05','25','15','75'],
                ['06','30','16','80'],['07','35','18','90'],['08','40','20','100'],['09','45','22','110'],
              ].map(([c1,b1,c2,b2]) => (
                <tr class="border-t border-theme">
                  <td class="px-3 py-1.5 font-mono text-theme-primary">{c1}</td>
                  <td class="px-3 py-1.5">{b1}</td>
                  <td class="px-3 py-1.5 font-mono text-theme-primary">{c2}</td>
                  <td class="px-3 py-1.5">{b2}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-sm mt-3"><strong class="text-theme-primary">Exception:</strong> Codes 00–03 do not follow the ×5 rule (see FAQ below).</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Suffix Reference: Seals & Shields</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-theme rounded-lg">
            <thead>
              <tr class="bg-theme-tertiary">
                <th class="px-3 py-2 text-left text-theme-primary">SKF</th>
                <th class="px-3 py-2 text-left text-theme-primary">NSK</th>
                <th class="px-3 py-2 text-left text-theme-primary">FAG</th>
                <th class="px-3 py-2 text-left text-theme-primary">NTN</th>
                <th class="px-3 py-2 text-left text-theme-primary">Meaning</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['2RS1','DDU','2RSR','2RS','Two rubber contact seals — best sealing, contaminated environments'],
                ['2Z','ZZ','2Z','ZZ','Two steel shields — non-contact, lower torque, clean environments'],
                ['RS1','DU','RSR','RS','One rubber contact seal (one side)'],
                ['Z','Z','Z','Z','One steel shield (one side)'],
                ['RZ','LLU','2RZ','LLB','Two non-contact rubber seals — low torque, moderate sealing'],
              ].map(([skf,nsk,fag,ntn,desc]) => (
                <tr class="border-t border-theme">
                  <td class="px-3 py-1.5 font-mono accent-text">{skf}</td>
                  <td class="px-3 py-1.5 font-mono">{nsk}</td>
                  <td class="px-3 py-1.5 font-mono">{fag}</td>
                  <td class="px-3 py-1.5 font-mono">{ntn}</td>
                  <td class="px-3 py-1.5 text-xs">{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Clearance Suffixes</h2>
        <div class="space-y-2">
          {[
            { code: 'C2', desc: 'Below standard clearance. Used in precision equipment where tight fit is required. Rare.' },
            { code: 'CN (no suffix)', desc: 'Standard (normal) clearance — C0 is the same designation. Default for most applications.' },
            { code: 'C3', desc: 'Greater than standard. Most common upgrade — use in electric motors, pumps, and any application with significant temperature rise.' },
            { code: 'C4', desc: 'Greater than C3. Heavy-duty industrial applications with large temperature differentials.' },
            { code: 'C5', desc: 'Greatest standard clearance. High-temperature industrial applications, rolling mill equipment.' },
          ].map(c => (
            <div class="flex gap-3 p-3 card">
              <span class="font-mono accent-text font-bold text-sm w-16 shrink-0">{c.code}</span>
              <p class="text-sm">{c.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Worked Example: Decoding 22318-E-XL-K-T41A</h2>
        <p>This is a FAG (Schaeffler) spherical roller bearing part number — more complex than a simple DGBB:</p>
        <div class="mt-3 space-y-2 font-mono text-sm">
          {[
            ['22', 'Type: Spherical roller bearing'],
            ['3', 'Width series 3'],
            ['18', 'Bore code 18 → 18 × 5 = 90 mm bore'],
            ['E', 'FAG: optimised internal geometry (E-design)'],
            ['XL', 'FAG: extended service life'],
            ['K', 'Tapered bore (1:12 taper), requires adapter sleeve'],
            ['T41A', 'FAG: specific polymer cage design'],
          ].map(([code, meaning]) => (
            <div class="flex gap-3">
              <span class="accent-text w-20 shrink-0">{code}</span>
              <span class="text-theme-secondary">{meaning}</span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-sm">Full bearing: 90 mm bore, spherical roller, tapered bore (adapter mount), E-design optimised internals, extended life cage.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Quick Cross-Reference: Common 6205 Variants</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border border-theme rounded-lg">
            <thead>
              <tr class="bg-theme-tertiary">
                <th class="px-3 py-2 text-left text-theme-primary">SKF</th>
                <th class="px-3 py-2 text-left text-theme-primary">NSK</th>
                <th class="px-3 py-2 text-left text-theme-primary">FAG</th>
                <th class="px-3 py-2 text-left text-theme-primary">NTN</th>
                <th class="px-3 py-2 text-left text-theme-primary">Meaning</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['6205','6205','6205','6205','Open, standard clearance'],
                ['6205-2RS1','6205DDU','6205-2RSR','6205LLU','Two rubber contact seals'],
                ['6205-2Z','6205ZZ','6205-2Z','6205ZZ','Two steel shields'],
                ['6205-2RS1/C3','6205DDU C3','6205-2RSR.C3','6205LLU/C3','Rubber seals + C3 clearance'],
                ['6205-2Z/C3','6205ZZ C3','6205-2Z.C3','6205ZZ/C3','Steel shields + C3 clearance'],
              ].map(([skf,nsk,fag,ntn,desc]) => (
                <tr class="border-t border-theme">
                  <td class="px-3 py-1.5 font-mono text-theme-primary text-xs">{skf}</td>
                  <td class="px-3 py-1.5 font-mono text-xs">{nsk}</td>
                  <td class="px-3 py-1.5 font-mono text-xs">{fag}</td>
                  <td class="px-3 py-1.5 font-mono text-xs">{ntn}</td>
                  <td class="px-3 py-1.5 text-xs text-theme-muted">{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">FAQ</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map((item) => (
            <details class="card">
              <summary class="font-semibold text-theme-primary cursor-pointer">{item.name}</summary>
              <p class="mt-2 text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>

    </div>

    <footer class="mt-10 pt-6 border-t border-theme">
      <p class="text-sm text-theme-muted mb-4">Use our tools to find cross-reference specifications:</p>
      <div class="flex flex-wrap gap-3">
        <a href="/bearing-interchange/" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-colors" style="color:#07090c;">Brand Interchange Tool</a>
        <a href="/bearing-size-chart/" class="text-sm font-semibold px-4 py-2 rounded-lg border border-theme hover:bg-theme-tertiary transition-colors text-theme-primary">Bearing Size Chart</a>
        <a href="/blog/" class="text-sm text-theme-muted hover:accent-text transition-colors">← Back to Blog</a>
      </div>
    </footer>
  </article>
</Base>
