---
import Base from '../../../layouts/Base.astro';

const title = 'Bearing Grease & Relubrication Intervals: Calculation Guide | BearingCalculators';
const description = 'How to calculate bearing relubrication intervals using the SKF/FAG formula. Covers grease quantity, speed factor, temperature correction, and common mistakes that cause premature bearing failure.';
const pubDate = '2026-10-14';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I calculate bearing relubrication interval?",
      "acceptedAnswer": { "@type": "Answer", "text": "The SKF relubrication interval formula: tf = (14,000,000 / (n × √d)) − 4×d, where n = rotational speed (rpm), d = bore diameter (mm), tf = interval in operating hours. This is a base value for standard conditions (70°C, horizontal shaft, clean environment). Multiply by correction factors for temperature, contamination level, and mounting position." }
    },
    {
      "@type": "Question",
      "name": "How much grease should I add at each relubrication?",
      "acceptedAnswer": { "@type": "Answer", "text": "Grease quantity formula: Gp = 0.005 × D × B, where D = bearing outer diameter (mm), B = bearing width (mm), Gp = grease quantity in grams. This is the quantity to add at each relubrication interval. Never fill a bearing housing more than 1/3 to 1/2 full — overpacking causes overheating and seal damage." }
    },
    {
      "@type": "Question",
      "name": "What happens if you over-grease a bearing?",
      "acceptedAnswer": { "@type": "Answer", "text": "Over-greasing is one of the leading causes of premature bearing failure. Excess grease churns inside the housing, generating heat that degrades both the grease and the bearing steel. Typical symptoms: bearing temperature rises 20–40°C above normal after relubrication, then slowly returns to normal as excess grease is expelled. If temperature does not return to normal within 2–4 hours, the bearing is permanently damaged." }
    },
    {
      "@type": "Question",
      "name": "What is the temperature correction factor for bearing relubrication?",
      "acceptedAnswer": { "@type": "Answer", "text": "For every 15°C above 70°C, halve the relubrication interval. For every 15°C below 70°C, you can double it. At 100°C, the interval is 1/4 of the base value. At 55°C, it is 2× the base value. Most standard NLGI 2 greases have upper working limits of 120–130°C; above this, use high-temperature grease (NLGI 2, synthetic base oil)." }
    },
    {
      "@type": "Question",
      "name": "Can I mix different bearing greases?",
      "acceptedAnswer": { "@type": "Answer", "text": "Mixing greases with incompatible thickener types causes the mixture to soften or harden unpredictably. Lithium and lithium complex are generally compatible. Lithium and calcium are incompatible. Polyurea and lithium are incompatible. If grease type is unknown, purge the old grease completely before applying new grease. Never mix without confirming compatibility from the grease manufacturer's data sheet." }
    },
  ],
};
---
<Base
  title={title}
  description={description}
  ogType="article"
  pubDate={pubDate}
  jsonLd={faqSchema}
  breadcrumbItems={[
    { name: 'Blog', url: '/blog/' },
    { name: 'Bearing Relubrication Intervals', url: '/blog/bearing-grease-relubrication-intervals/' },
  ]}
>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <header class="mb-8">
      <p class="text-xs text-theme-muted mb-2">Published 14 Oct 2026 · 9 min read</p>
      <h1 class="text-3xl font-bold text-theme-primary mb-3">Bearing Grease & Relubrication Intervals</h1>
      <p class="text-theme-secondary text-lg">Over-greasing and under-greasing are both leading causes of bearing failure. This guide gives you the formula to calculate the right interval and the right quantity — and explains the temperature and speed corrections most maintenance teams skip.</p>
    </header>

    <div class="space-y-6 text-theme-secondary">

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Why Lubrication Interval Matters</h2>
        <p>Studies by bearing manufacturers consistently show that 36–40% of premature bearing failures are caused by improper lubrication — either too much, too little, the wrong type, or at the wrong interval. The base bearing is rarely the failure point; the lubrication regime is.</p>
        <p class="mt-3">Two failure modes dominate: <strong class="text-theme-primary">grease starvation</strong> (metal-to-metal contact as grease degrades) and <strong class="text-theme-primary">grease churning</strong> (overpacked housing, temperature rise, accelerated oxidation of the base oil).</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">The Relubrication Interval Formula</h2>
        <p>The SKF/FAG industry-standard formula for relubrication interval under normal conditions:</p>
        <div class="my-4 p-4 card bg-theme-tertiary font-mono text-sm">
          <p class="accent-text text-base font-bold">tf = (14,000,000 / (n × √d)) − 4×d</p>
          <div class="mt-3 space-y-1 text-theme-secondary text-xs">
            <p><span class="text-theme-primary">tf</span> = relubrication interval (operating hours)</p>
            <p><span class="text-theme-primary">n</span> = rotational speed (rpm)</p>
            <p><span class="text-theme-primary">d</span> = bearing bore diameter (mm)</p>
          </div>
        </div>
        <p>Valid for: horizontal shaft, single-row radial load ≤0.1 × C (dynamic load rating), temperature ≤70°C, clean non-corrosive environment, NLGI 2 lithium-based grease.</p>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm border border-theme rounded-lg">
            <thead>
              <tr class="bg-theme-tertiary">
                <th class="px-3 py-2 text-left text-theme-primary">Application</th>
                <th class="px-3 py-2 text-right text-theme-primary">d (mm)</th>
                <th class="px-3 py-2 text-right text-theme-primary">n (rpm)</th>
                <th class="px-3 py-2 text-right text-theme-primary">tf (hours)</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['Small conveyor idler', '25', '1,500', '~3,200'],
                ['Medium pump shaft', '50', '1,450', '~1,600'],
                ['Large fan bearing', '80', '960', '~1,400'],
                ['Gearbox output shaft', '100', '500', '~3,500'],
                ['High-speed motor', '40', '3,000', '~650'],
              ].map(([app, d, n, tf]) => (
                <tr class="border-t border-theme">
                  <td class="px-3 py-2">{app}</td>
                  <td class="px-3 py-2 text-right font-mono">{d}</td>
                  <td class="px-3 py-2 text-right font-mono">{n}</td>
                  <td class="px-3 py-2 text-right font-mono accent-text font-bold">{tf}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-theme-muted mt-2">Calculated at 70°C, horizontal shaft, standard conditions. Apply corrections for actual operating conditions.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Temperature Correction Factors</h2>
        <p>This is the correction most teams miss. For every 15°C above 70°C, the interval is halved:</p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full text-sm border border-theme rounded-lg">
            <thead>
              <tr class="bg-theme-tertiary">
                <th class="px-3 py-2 text-left text-theme-primary">Operating Temperature</th>
                <th class="px-3 py-2 text-right text-theme-primary">Correction Factor</th>
                <th class="px-3 py-2 text-left text-theme-primary">Action</th>
              </tr>
            </thead>
            <tbody>
              {[
                ['≤50°C', '2.0×', 'Double the calculated interval'],
                ['50–65°C', '1.5×', 'Extend interval by 50%'],
                ['65–80°C', '1.0×', 'Use calculated interval as-is'],
                ['80–95°C', '0.5×', 'Halve the interval'],
                ['95–110°C', '0.25×', 'Quarter the interval; check grease type'],
                ['>110°C', 'Consult data', 'Use high-temperature synthetic grease'],
              ].map(([temp, factor, action]) => (
                <tr class="border-t border-theme">
                  <td class="px-3 py-2 font-mono text-theme-primary">{temp}</td>
                  <td class="px-3 py-2 text-right font-mono accent-text">{factor}</td>
                  <td class="px-3 py-2 text-sm">{action}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Grease Quantity Formula</h2>
        <div class="my-4 p-4 card bg-theme-tertiary font-mono text-sm">
          <p class="accent-text text-base font-bold">Gp = 0.005 × D × B</p>
          <div class="mt-3 space-y-1 text-theme-secondary text-xs">
            <p><span class="text-theme-primary">Gp</span> = grease quantity to add (grams)</p>
            <p><span class="text-theme-primary">D</span> = bearing outer diameter (mm)</p>
            <p><span class="text-theme-primary">B</span> = bearing width (mm)</p>
          </div>
        </div>
        <p>For a 6205 bearing (52 mm OD × 15 mm width): Gp = 0.005 × 52 × 15 = <strong class="text-theme-primary">3.9 grams</strong> per relubrication.</p>
        <p class="mt-3">Use a grease gun with a known output per stroke. Most grease guns deliver 1–3 grams per stroke — verify yours with a scale before starting a relubrication programme.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">Grease Type Selection Summary</h2>
        <div class="space-y-3">
          {[
            {
              condition: 'Standard industrial (−20°C to 110°C)',
              grease: 'NLGI 2, lithium or lithium-complex, mineral base oil',
              examples: 'SKF LGMT 2, FAG Arcanol MULTI2, Shell Gadus S2 V100',
            },
            {
              condition: 'High temperature (>110°C)',
              grease: 'NLGI 2, polyurea or lithium-complex, synthetic (PAO) base oil',
              examples: 'SKF LGHP 2, FAG Arcanol TEMP90, Klüber Isoflex Topas',
            },
            {
              condition: 'High speed (ndm > 250,000)',
              grease: 'NLGI 1–2, low bleed, low viscosity base oil (46–68 cSt)',
              examples: 'SKF LGGB 2, NSK Grease NS7',
            },
            {
              condition: 'Wet/washout environment',
              grease: 'NLGI 2, calcium-sulfonate complex, water-resistant',
              examples: 'Mobilgrease XHP 222, Molykote G-0052FG',
            },
            {
              condition: 'Food-grade (H1 approval)',
              grease: 'NSF H1 certified NLGI 2, PAO or white mineral base',
              examples: 'Klüber Paraliq GTE 703, Fuchs Cassida Fluid GL',
            },
          ].map(g => (
            <div class="p-4 card">
              <p class="font-semibold text-theme-primary text-sm">{g.condition}</p>
              <p class="text-sm mt-1">{g.grease}</p>
              <p class="text-xs text-theme-muted mt-1">Examples: {g.examples}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-theme-primary mb-3">FAQ</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map((item) => (
            <details class="card">
              <summary class="font-semibold text-theme-primary cursor-pointer">{item.name}</summary>
              <p class="mt-2 text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>

    </div>

    <footer class="mt-10 pt-6 border-t border-theme">
      <p class="text-sm text-theme-muted mb-4">Calculate bearing life and loads with our free tools:</p>
      <div class="flex flex-wrap gap-3">
        <a href="/bearing-life-calculator/" class="accent-bg text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-colors" style="color:#07090c;">Bearing Life Calculator (L10)</a>
        <a href="/bearing-calculator/" class="text-sm font-semibold px-4 py-2 rounded-lg border border-theme hover:bg-theme-tertiary transition-colors text-theme-primary">Bearing Load Calculator</a>
        <a href="/blog/" class="text-sm text-theme-muted hover:accent-text transition-colors">← Back to Blog</a>
      </div>
    </footer>
  </article>
</Base>
